# Copy file này thành .env trước khi chạy: cp .env.example .env
# KHÔNG commit file .env thật (chứa mật khẩu) lên git — đã có trong .gitignore

# --- SQL Server ---
SQLSERVER_SA_PASSWORD=YourStrong!Passw0rd

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=YourStrong!Passw0rd

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
