{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",

  "Jwt": {
    "Issuer": "SimpleStore.Identity",
    "Audience": "SimpleStore",
    "SigningKey": "dev-only-super-secret-key-change-me-32chars-min"
  },

  "ReverseProxy": {
    "Routes": {
      "identity-register-route": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/identity/register",
          "Methods": [ "POST" ]
        }
      },
      "identity-login-route": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/identity/login",
          "Methods": [ "POST" ]
        }
      },
      "identity-refresh-route": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/identity/refresh",
          "Methods": [ "POST" ]
        }
      },
      "identity-logout-route": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/identity/logout",
          "Methods": [ "POST" ]
        }
      },
      "identity-protected-route": {
        "ClusterId": "identity-cluster",
        "Order": 100,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/identity/{**catch-all}" }
      },

      "catalog-read-route": {
        "ClusterId": "catalog-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/catalog/products/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "catalog-write-route": {
        "ClusterId": "catalog-cluster",
        "Order": 0,
        "AuthorizationPolicy": "admin-only",
        "Match": {
          "Path": "/api/v1/catalog/products/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/cart/{**catch-all}" }
      },

      "order-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      },

      "inventory-read-route": {
        "ClusterId": "inventory-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/v1/inventory/items/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "inventory-write-route": {
        "ClusterId": "inventory-cluster",
        "Order": 0,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/v1/inventory/items/{**catch-all}",
          "Methods": [ "POST" ]
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5001/" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5003/" }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5004/" }
        }
      },

      "order-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5005/" }
        }
      },

      "inventory-cluster": {
        "Destinations": { "destination1": { "Address": "http://localhost:5006/" } }
      }
    }
  }
}